{
  "name": "jey-adapter-mcp",
  "version": "0.0.0",
  "private": true,
  "description": "MCP server exposing Jey's three v1 judgment tools over stdio. Capability exposure, not a transparent interception of every agent host.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "jey-mcp": "dist/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./main": {
      "types": "./dist/main.d.ts",
      "default": "./dist/main.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "node --test \"test/unit/*.test.ts\" \"test/contract/*.test.ts\"",
    "test:property": "echo \"no property tests in this package yet\" && exit 0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.1",
    "ajv": "8.17.1",
    "jey-contracts": "workspace:*",
    "jey-core": "workspace:*",
    "jey-provider-local": "workspace:*",
    "jey-provider-mock": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
