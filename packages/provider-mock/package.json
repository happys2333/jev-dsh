{
  "name": "jey-provider-mock",
  "version": "0.0.0",
  "private": true,
  "description": "The synthetic decision provider both Jey adapters use in tests. One implementation on purpose: the point of a mock is that it can never pretend to be a real answer.",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:property": "echo \"no property tests in this package\" && exit 0"
  },
  "dependencies": {
    "jey-contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "typescript": "5.9.3"
  }
}
